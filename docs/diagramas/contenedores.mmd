    Container(app, "App Android", "Kotlin, Compose, Room, Retrofit", "Cola offline y sincronización por lotes")
  }

  System_Ext(cognito, "AWS Cognito", "User pool opcional")

  Rel(coordinador, web, "Usa", "HTTPS")
  Rel(monitor, web, "Consulta", "HTTPS")
  Rel(asistente, app, "Usa", "HTTPS")
  Rel(web, api, "Llama endpoints", "JSON / Bearer JWT")
  Rel(app, api, "Login, catálogo y /api/sync/lote", "JSON / Bearer JWT")
  Rel(api, db, "Lee y escribe", "JPA / JDBC")
