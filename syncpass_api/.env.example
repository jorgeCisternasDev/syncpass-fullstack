# Perfil activo: local | postgres | cognito | postgres,cognito
SPRING_PROFILES_ACTIVE=local

# --- Base de datos ---
# local usa H2 en memoria y no requiere estas variables.
# postgres requiere una base existente y un usuario con permisos.
# DATABASE_URL=jdbc:postgresql://localhost:5432/syncpass
# DATABASE_USER=syncpass
# DATABASE_PASSWORD=
# DB_POOL_MAX=5
# DB_POOL_MIN=1
# DDL_AUTO=validate
# Para desarrollo sobre PostgreSQL se puede usar DDL_AUTO=update.

# --- JWT local ---
# Cambiar en cada entorno. No versionar el valor real.
JWT_SECRET=cambia-esta-clave-de-al-menos-32-bytes
JWT_ISSUER=syncpass-api
JWT_TTL_MINUTES=60

# --- CORS del panel web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Cognito (solo perfil cognito) ---
# El issuer debe coincidir exactamente con el issuer del user pool.
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
# AWS_REGION=us-east-1
# AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_COGNITO_CLIENT_SECRET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

SERVER_PORT=8080
LOG_LEVEL=INFO
